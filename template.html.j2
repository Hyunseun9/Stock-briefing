<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light only">
<meta name="theme-color" content="#f9f9f7">
<title>미국주식 브리핑 — {{ date_kr }}</title>
<style>
  .viz-root {
    color-scheme: light;
    --page:           #f9f9f7;
    --surface-1:      #fcfcfb;
    --text-primary:   #0b0b0b;
    --text-secondary: #52514e;
    --text-muted:     #898781;
    --gridline:       #e1e0d9;
    --border:         rgba(11,11,11,0.10);
    --good:           #006300;
    --good-bg:        #e8f5e8;
    --critical:       #d03b3b;
    --critical-bg:    #fbeaea;
    --series-blue:    #2a78d6;
    --meter-track:    #e1e0d9;
    --gauge-track:    #e7e6e1;
  }
  /* Fixed light theme regardless of device/browser dark-mode setting. */

  * { box-sizing: border-box; }
  html, body { overflow-x: hidden; max-width: 100%; color-scheme: light; }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--page);
    color: var(--text-primary);
  }
  .wrap { max-width: 640px; margin: 0 auto; padding: 28px 20px 40px; }
  .top-bar { display: flex; justify-content: flex-end; margin-bottom: 8px; position: relative; }
  .cal-btn {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; color: var(--text-secondary); background: var(--surface-1);
    border: 1px solid var(--border); border-radius: 999px; padding: 5px 12px; cursor: pointer;
  }
  .cal-btn svg { display: block; }
  .cal-popover {
    display: none; position: absolute; right: 0; top: 34px; z-index: 20;
    background: var(--surface-1); border: 1px solid var(--border); border-radius: 12px;
    padding: 10px; width: 240px;
    box-shadow: 0 10px 28px rgba(0,0,0,0.16);
  }
  .cal-popover.open { display: block; }
  .cal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
  .cal-month-label { font-size: 13px; font-weight: 700; }
  .cal-nav-btn {
    width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--border); border-radius: 6px; background: var(--page);
    color: var(--text-secondary); cursor: pointer;
  }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .cal-dow { font-size: 10px; color: var(--text-muted); text-align: center; padding: 2px 0; }
  .cal-day {
    font-size: 11.5px; text-align: center; padding: 5px 0; border-radius: 6px;
    color: var(--text-muted); text-decoration: none;
  }
  a.cal-day.has-report { color: var(--text-primary); font-weight: 700; background: var(--page); cursor: pointer; }
  a.cal-day.has-report:hover { background: var(--series-blue); color: #fff; }
  .cal-day.current { outline: 1.5px solid var(--series-blue); }

  header { margin-bottom: 24px; }
  .eyebrow {
    font-size: 12px; font-weight: 600; letter-spacing: 0.04em; color: var(--series-blue);
    text-transform: uppercase; margin: 0 0 6px;
  }
  h1 { font-size: 22px; font-weight: 700; margin: 0 0 16px; line-height: 1.3; }

  .index-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; margin-bottom: 10px; }
  .index-tile {
    display: flex; flex-direction: column; gap: 2px;
    background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px;
    padding: 6px 5px; min-width: 0;
  }
  .index-name { font-size: 10.5px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .index-nums { display: flex; align-items: baseline; gap: 2px 5px; min-width: 0; flex-wrap: wrap; }
  .index-value { font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .index-delta { font-size: 11.5px; font-weight: 600; flex-shrink: 0; white-space: nowrap; }
  .index-delta.up { color: var(--good); }
  .index-delta.down { color: var(--critical); }

  .section-divider {
    display: flex; align-items: center; gap: 10px;
    margin: 18px 0 10px; font-size: 11px; font-weight: 700;
    letter-spacing: 0.05em; color: var(--text-muted);
  }
  .section-divider::before, .section-divider::after {
    content: ''; flex: 1; height: 1px; background: var(--gridline);
  }
  .section-divider-meta {
    font-weight: 400; letter-spacing: normal; font-size: 10px;
    color: var(--text-muted); opacity: 0.85;
  }

  .card {
    background: var(--surface-1); border: 1px solid var(--border); border-radius: 14px;
    padding: 10px 18px; margin-bottom: 7px;
  }

  .card-head {
    display: grid;
    grid-template-columns: 132px 1fr auto auto;
    grid-template-areas: "tkr fg price news";
    align-items: center;
    gap: 10px; row-gap: 8px;
  }
  .ticker-block {
    grid-area: tkr;
    display: flex; flex-direction: column; gap: 1px;
    min-width: 0; overflow: hidden;
    cursor: pointer;
  }
  .ticker { font-size: 18px; font-weight: 700; line-height: 1.2; }
  .ticker .chev { font-size: 11px; color: var(--text-muted); margin-left: 2px; font-weight: 500; }
  .company {
    font-size: 11.5px; color: var(--text-muted); line-height: 1.25;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .dominance-tag {
    display: block; font-size: 10.5px; font-weight: 600; color: var(--text-muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .price-block { grid-area: price; text-align: right; min-width: 0; }
  .price { font-size: 19px; font-weight: 700; font-variant-numeric: proportional-nums; white-space: nowrap; }
  .delta {
    display: inline-flex; align-items: center; gap: 3px; font-size: 12px; font-weight: 600;
    padding: 1px 7px; border-radius: 999px; margin-top: 3px; white-space: nowrap;
  }
  .delta.up { color: var(--good); background: var(--good-bg); }
  .delta.down { color: var(--critical); background: var(--critical-bg); }

  .fg-strip {
    grid-area: fg;
    display: inline-flex; align-items: center; justify-self: start;
    gap: 7px;
    background: var(--page);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 4px 9px;
    max-width: 100%;
    min-width: 0;
  }
  .fg-left { display: flex; align-items: center; gap: 8px; }
  .fg-gauge-svg { flex-shrink: 0; line-height: 0; display: flex; }
  .fg-text { display: flex; align-items: baseline; gap: 6px; flex-shrink: 0; }
  .fg-text-score { font-size: 20px; font-weight: 700; line-height: 1; font-variant-numeric: proportional-nums; white-space: nowrap; }
  .fg-text-score.zone-fear { color: var(--critical); }
  .fg-text-score.zone-neutral { color: var(--text-secondary); }
  .fg-text-score.zone-greed { color: var(--good); }
  .fg-text-zone { font-size: 13px; font-weight: 600; color: var(--text-secondary); white-space: nowrap; }
  .fg-divider { width: 1px; align-self: stretch; background: var(--gridline); }

  .fg-stats { display: flex; flex-direction: column; gap: 3px; }
  .stat-line {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    font-size: 12.5px; white-space: nowrap;
  }
  .stat-label { color: var(--text-muted); }
  .stat-value { font-weight: 700; color: var(--text-secondary); }
  .stat-value.zone-oversold { color: var(--good); }
  .stat-value.zone-overbought { color: var(--critical); }
  .stat-value b { font-weight: 700; color: var(--text-primary); }
  .trend-arrow { font-size: 10.5px; color: var(--text-muted); margin-left: 2px; }

  .news-toggle { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .news-btn {
    grid-area: news;
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; flex-shrink: 0;
    border: 1px solid var(--border); border-radius: 50%;
    background: var(--page); color: var(--text-muted);
    cursor: pointer; user-select: none;
  }
  .news-btn svg { display: block; }
  .news-toggle:checked ~ .card-head .news-btn {
    color: var(--series-blue); border-color: var(--series-blue);
  }
  .news-body { max-height: 0; overflow: hidden; }
  .news-toggle:checked ~ .news-body {
    max-height: 2000px; margin-top: 14px; padding-top: 14px;
    border-top: 1px solid var(--gridline);
  }
  .news-body p { font-size: 13.5px; line-height: 1.6; color: var(--text-secondary); margin: 0 0 8px; }
  .news-body p:last-child { margin-bottom: 0; }
  .news-body b { color: var(--text-primary); font-weight: 600; }
  .src-link {
    display: inline-flex; vertical-align: -2px; margin-left: 5px;
    color: var(--text-muted); text-decoration: none; flex-shrink: 0;
  }
  .src-link svg { display: block; }
  .src-link:hover { color: var(--series-blue); }

  .headline-block { display: flex; flex-direction: column; gap: 5px; margin: 0; min-height: 44px; }
  .headline-row {
    display: flex; align-items: baseline; gap: 7px;
    font-size: 13px; color: var(--text-secondary); line-height: 1.5;
    min-width: 0;
  }
  .headline-row span:not(.headline-tag) {
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .headline-tag {
    flex-shrink: 0; font-size: 10px; font-weight: 700; letter-spacing: 0.03em;
    color: var(--text-muted); min-width: 30px;
  }

  /* Ticker detail drawer */
  .drawer-overlay {
    display: none; position: fixed; inset: 0; background: rgba(11,11,11,0.35); z-index: 50;
  }
  .drawer-overlay.open { display: block; }
  .drawer {
    position: fixed; top: 0; right: 0; height: 100%; width: min(340px, 86vw);
    background: var(--surface-1); z-index: 51; padding: 20px;
    box-shadow: -10px 0 30px rgba(0,0,0,0.18);
    transform: translateX(100%); transition: transform 0.22s ease;
    overflow-y: auto; visibility: hidden;
  }
  .drawer.open { transform: translateX(0); visibility: visible; }
  .drawer-close {
    width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--border);
    background: var(--page); color: var(--text-secondary); cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px;
  }
  .drawer-title { font-size: 18px; font-weight: 700; margin: 0 0 2px; }
  .drawer-sub { font-size: 12px; color: var(--text-muted); margin: 0 0 16px; }
  .tab-bar { display: flex; gap: 4px; margin-bottom: 12px; border-bottom: 1px solid var(--gridline); }
  .tab-btn {
    font-size: 13px; font-weight: 600; color: var(--text-muted); background: none; border: none;
    padding: 8px 10px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px;
  }
  .tab-btn.active { color: var(--series-blue); border-bottom-color: var(--series-blue); }
  .tab-panel[hidden] { display: none; }
  .detail-row {
    display: flex; justify-content: space-between; align-items: baseline; gap: 10px;
    padding: 8px 0; border-bottom: 1px solid var(--gridline); font-size: 13px;
  }
  .detail-row:last-child { border-bottom: none; }
  .detail-label { color: var(--text-muted); white-space: nowrap; flex-shrink: 0; }
  .detail-value { font-weight: 700; color: var(--text-primary); text-align: right; font-variant-numeric: tabular-nums; }

  .mini-section-title {
    font-size: 12px; font-weight: 700; color: var(--text-secondary);
    margin: 18px 0 6px;
  }
  .div-history-row {
    display: flex; justify-content: space-between; align-items: baseline;
    font-size: 12.5px; padding: 6px 0; border-bottom: 1px solid var(--gridline);
  }
  .div-history-row:last-child { border-bottom: none; }
  .div-history-row .dhr-date { color: var(--text-muted); }
  .div-history-row .dhr-amount { font-weight: 700; color: var(--text-primary); font-variant-numeric: tabular-nums; }

  .quarter-block { padding: 9px 0; border-bottom: 1px solid var(--gridline); }
  .quarter-block:last-child { border-bottom: none; }
  .quarter-period { font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 5px; }
  .quarter-line {
    display: flex; align-items: baseline; gap: 6px;
    font-size: 12px; color: var(--text-secondary); margin-bottom: 3px; flex-wrap: wrap;
  }
  .quarter-line:last-child { margin-bottom: 0; }
  .quarter-line .qline-label { color: var(--text-muted); flex-shrink: 0; min-width: 30px; }
  .result-badge {
    font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 999px;
    white-space: nowrap;
  }
  .result-badge.beat { color: var(--good); background: var(--good-bg); }
  .result-badge.miss { color: var(--critical); background: var(--critical-bg); }
  .result-badge.inline { color: var(--text-secondary); background: var(--page); }
  .tab-footnote {
    font-size: 10.5px; color: var(--text-muted); line-height: 1.55; margin: 14px 0 0;
  }

  @media (max-width: 480px) {
    .card-head {
      grid-template-columns: 1fr auto auto;
      grid-template-areas: "tkr price news" "fg fg fg";
    }
    .fg-strip { justify-self: stretch; width: 100%; padding: 3px 8px; gap: 5px; }
    .fg-gauge-svg svg { width: 36px; height: 21px; }
    .fg-text-score { font-size: 14px; }
    .fg-text-zone { font-size: 10.5px; }
    .fg-stats { gap: 0px; }
    .stat-line { font-size: 10px; gap: 6px; }
    .stat-label { font-size: 10px; }
    .section-divider > span { display: flex; flex-direction: column; align-items: center; gap: 1px; }
    .section-divider-meta { font-size: 9px; }
  }
</style>
</head>
<body>
<div class="viz-root">
  <div class="wrap">
    <div class="top-bar">
      <button class="cal-btn" id="calBtn" type="button">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        지난 리포트
      </button>
      <div class="cal-popover" id="calPopover">
        <div class="cal-header">
          <button class="cal-nav-btn" id="calPrev" type="button">‹</button>
          <span class="cal-month-label" id="calMonthLabel"></span>
          <button class="cal-nav-btn" id="calNext" type="button">›</button>
        </div>
        <div class="cal-grid" id="calGrid"></div>
      </div>
    </div>

    {% macro ticker_card(t) %}
    <div class="card">
      <input type="checkbox" id="news-{{ t.ticker|lower }}" class="news-toggle">
      <div class="card-head">
        <div class="ticker-block" data-ticker="{{ t.ticker }}">
          <span class="ticker">{{ t.ticker }}<span class="chev">›</span></span>
          <span class="company">{{ t.company }}</span>
          {% if t.type == 'coin' and t.dominance %}<span class="dominance-tag">점유율 {{ t.dominance }}</span>{% endif %}
        </div>
        <div class="fg-strip">
          <div class="fg-left">
            <div class="fg-gauge-svg" data-gauge data-score="{{ t.fg_score }}"></div>
            <div class="fg-text">
              <span class="fg-text-score zone-{{ t.fg_zone_class }}">{{ t.fg_score }}</span>
              <span class="fg-text-zone">{{ t.fg_zone_label }}</span>
            </div>
          </div>
          <div class="fg-divider"></div>
          <div class="fg-stats">
            <div class="stat-line">
              <span class="stat-label">일봉 RSI</span>
              <span class="stat-value zone-{{ t.rsi_d_zone }}"><b>{{ t.rsi_d }}</b><span class="trend-arrow">{{ t.rsi_d_arrow }}</span></span>
            </div>
            {% if t.type != 'coin' %}
            <div class="stat-line">
              <span class="stat-label">주봉 RSI</span>
              <span class="stat-value zone-{{ t.rsi_w_zone }}"><b>{{ t.rsi_w }}</b><span class="trend-arrow">{{ t.rsi_w_arrow }}</span></span>
            </div>
            <div class="stat-line">
              <span class="stat-label">베타</span>
              <span class="stat-value"><b>{{ t.beta }}</b></span>
            </div>
            {% endif %}
          </div>
        </div>
        <div class="price-block">
          <div class="price">${{ t.price }}</div>
          <div class="delta {{ t.direction }}">{{ '▲' if t.direction == 'up' else '▼' }} {{ t.change_pct }}%</div>
        </div>
        <label for="news-{{ t.ticker|lower }}" class="news-btn"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg></label>
      </div>

      <div class="news-body">
        {% for n in t.news %}
        <p><b>{{ n.label }}:</b> {{ n.text }} <a class="src-link" href="{{ n.url }}" target="_blank" rel="noopener"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a></p>
        {% endfor %}
      </div>
    </div>
    {% endmacro %}

    <header>
      <p class="eyebrow">일일 주식 브리핑</p>
      <h1>미국주식 — {{ date_kr }}</h1>
      <div class="index-row">
        {% for idx in indices %}
        <div class="index-tile">
          <span class="index-name">{{ idx.name }}</span>
          <span class="index-nums">
            <span class="index-value">{{ idx.value }}</span>
            <span class="index-delta {{ idx.direction }}">{{ '▲' if idx.direction == 'up' else '▼' }}{{ idx.change_pct }}%</span>
          </span>
        </div>
        {% endfor %}
      </div>
      <div class="headline-block">
        <div class="headline-row" id="hlRow0"></div>
        <div class="headline-row" id="hlRow1"></div>
      </div>
    </header>

    {% for t in tickers if t.type == 'stock' %}
    {{ ticker_card(t) }}
    {% endfor %}

    {% if tickers|selectattr('type', 'equalto', 'etf')|list %}
    <div class="section-divider"><span>ETF</span></div>
    {% endif %}

    {% for t in tickers if t.type == 'etf' %}
    {{ ticker_card(t) }}
    {% endfor %}

    {% if tickers|selectattr('type', 'equalto', 'coin')|list %}
    <div class="section-divider"><span>코인<span class="section-divider-meta">{% if crypto_meta %} · 업데이트 {{ crypto_meta.updated_at }} · BTC 도미넌스 {{ crypto_meta.btc_dominance }}{% endif %}</span></span></div>
    {% endif %}

    {% for t in tickers if t.type == 'coin' %}
    {{ ticker_card(t) }}
    {% endfor %}
  </div>

  <div class="drawer-overlay" id="drawerOverlay"></div>
  <div class="drawer" id="drawer">
    <button class="drawer-close" id="drawerClose" type="button">✕</button>
    {% for t in tickers %}
    <div class="drawer-panel" id="drawer-{{ t.ticker }}" hidden>
      <p class="drawer-title">{{ t.ticker }}</p>
      <p class="drawer-sub">{{ t.company }}</p>
      <div class="tab-bar">
        {% for tab in t.tabs %}
        <button class="tab-btn{{ ' active' if loop.first else '' }}" data-tab-btn="{{ t.ticker }}-{{ tab.key }}" type="button">{{ tab.label }}</button>
        {% endfor %}
      </div>
      {% for tab in t.tabs %}
      <div class="tab-panel" data-tab-panel="{{ t.ticker }}-{{ tab.key }}"{{ '' if loop.first else ' hidden' }}>
        {% for d in tab.rows %}
        <div class="detail-row">
          <span class="detail-label">{{ d.label }}</span>
          <span class="detail-value">{{ d.value }}</span>
        </div>
        {% endfor %}
        {% if tab.history %}
        <div class="mini-section-title">배당 내역 (최근 {{ tab.history|length }}회)</div>
        {% for h in tab.history %}
        <div class="div-history-row">
          <span class="dhr-date">{{ h.date }}</span>
          <span class="dhr-amount">{{ h.amount }}</span>
        </div>
        {% endfor %}
        {% endif %}
        {% if tab.quarters %}
        <div class="mini-section-title">분기별 실적 (최근 {{ tab.quarters|length }}개)</div>
        {% for q in tab.quarters %}
        <div class="quarter-block">
          <div class="quarter-period">{{ q.period }}</div>
          <div class="quarter-line">
            <span class="qline-label">EPS</span>
            <span>{{ q.eps_actual }}{% if q.eps_est and 'N/A' not in q.eps_est %} / 예상 {{ q.eps_est }}{% endif %}</span>
            {% if q.eps_result in ['beat', 'miss', 'inline'] %}<span class="result-badge {{ q.eps_result }}">{{ {'beat': '상회', 'miss': '하회', 'inline': '부합'}[q.eps_result] }}</span>{% endif %}
          </div>
          {% if q.rev_actual and 'N/A' not in q.rev_actual %}
          <div class="quarter-line">
            <span class="qline-label">매출</span>
            <span>{{ q.rev_actual }}{% if q.rev_est and 'N/A' not in q.rev_est %} / 예상 {{ q.rev_est }}{% endif %}</span>
            {% if q.rev_result in ['beat', 'miss', 'inline'] %}<span class="result-badge {{ q.rev_result }}">{{ {'beat': '상회', 'miss': '하회', 'inline': '부합'}[q.rev_result] }}</span>{% endif %}
          </div>
          {% endif %}
        </div>
        {% endfor %}
        {% endif %}
        {% if tab.footnote %}
        <p class="tab-footnote">{{ tab.footnote }}</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</div>

<script>
  function polar(cx, cy, r, angleDeg) {
    const a = angleDeg * Math.PI / 180;
    return { x: cx + r * Math.cos(a), y: cy - r * Math.sin(a) };
  }

  function sectorPath(cx, cy, rOuter, rInner, aStart, aEnd) {
    const oStart = polar(cx, cy, rOuter, aStart);
    const oEnd = polar(cx, cy, rOuter, aEnd);
    const iEnd = polar(cx, cy, rInner, aEnd);
    const iStart = polar(cx, cy, rInner, aStart);
    return `M ${oStart.x.toFixed(2)} ${oStart.y.toFixed(2)} ` +
           `A ${rOuter} ${rOuter} 0 0 1 ${oEnd.x.toFixed(2)} ${oEnd.y.toFixed(2)} ` +
           `L ${iEnd.x.toFixed(2)} ${iEnd.y.toFixed(2)} ` +
           `A ${rInner} ${rInner} 0 0 0 ${iStart.x.toFixed(2)} ${iStart.y.toFixed(2)} Z`;
  }

  function buildGauge(score) {
    const cx = 27, cy = 27, rOuter = 20, rInner = 12;
    const svgNS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(svgNS, 'svg');
    svg.setAttribute('width', '55');
    svg.setAttribute('height', '31');
    svg.setAttribute('viewBox', '0 0 55 31');
    svg.style.overflow = 'visible';

    const bounds = [0, 20, 40, 60, 80, 100];
    const gap = 1.4;
    const angleOf = v => 180 - v * 1.8;
    const zoneIdx = score < 20 ? 0 : score < 40 ? 1 : score < 60 ? 2 : score < 80 ? 3 : 4;
    const rootStyle = getComputedStyle(document.querySelector('.viz-root'));
    const track = rootStyle.getPropertyValue('--gauge-track').trim();
    const critical = rootStyle.getPropertyValue('--critical').trim();
    const good = rootStyle.getPropertyValue('--good').trim();
    const primary = rootStyle.getPropertyValue('--text-primary').trim();
    const surface = rootStyle.getPropertyValue('--surface-1').trim();

    const zoneColors = [
      critical,
      'color-mix(in srgb, ' + critical + ' 55%, ' + track + ')',
      track,
      'color-mix(in srgb, ' + good + ' 55%, ' + track + ')',
      good
    ];

    for (let i = 0; i < 5; i++) {
      const startV = bounds[i] + (i > 0 ? gap : 0);
      const endV = bounds[i + 1] - (i < 4 ? gap : 0);
      const path = document.createElementNS(svgNS, 'path');
      path.setAttribute('d', sectorPath(cx, cy, rOuter, rInner, angleOf(startV), angleOf(endV)));
      path.setAttribute('fill', i === zoneIdx ? zoneColors[i] : track);
      svg.appendChild(path);
    }

    const needleAngle = angleOf(score);
    const tip = polar(cx, cy, rInner - 1, needleAngle);
    const needle = document.createElementNS(svgNS, 'line');
    needle.setAttribute('x1', cx);
    needle.setAttribute('y1', cy);
    needle.setAttribute('x2', tip.x);
    needle.setAttribute('y2', tip.y);
    needle.setAttribute('stroke', primary);
    needle.setAttribute('stroke-width', '2');
    needle.setAttribute('stroke-linecap', 'round');
    svg.appendChild(needle);

    const hub = document.createElementNS(svgNS, 'circle');
    hub.setAttribute('cx', cx);
    hub.setAttribute('cy', cy);
    hub.setAttribute('r', 2);
    hub.setAttribute('fill', primary);
    hub.setAttribute('stroke', surface);
    hub.setAttribute('stroke-width', '1.3');
    svg.appendChild(hub);

    return svg;
  }

  document.querySelectorAll('[data-gauge]').forEach(el => {
    const score = Number(el.getAttribute('data-score'));
    el.appendChild(buildGauge(score));
  });

  /* ---- Ticker detail drawer ---- */
  const drawerOverlay = document.getElementById('drawerOverlay');
  const drawer = document.getElementById('drawer');
  function openDrawer(ticker) {
    document.querySelectorAll('.drawer-panel').forEach(p => { p.hidden = (p.id !== 'drawer-' + ticker); });
    drawerOverlay.classList.add('open');
    drawer.classList.add('open');
  }
  function closeDrawer() {
    drawerOverlay.classList.remove('open');
    drawer.classList.remove('open');
  }
  document.querySelectorAll('.ticker-block[data-ticker]').forEach(el => {
    el.addEventListener('click', () => openDrawer(el.getAttribute('data-ticker')));
  });
  document.getElementById('drawerClose').addEventListener('click', closeDrawer);
  drawerOverlay.addEventListener('click', closeDrawer);

  /* ---- Drawer tabs ---- */
  document.querySelectorAll('[data-tab-btn]').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-tab-btn');
      const ticker = key.split('-')[0];
      const panel = document.getElementById('drawer-' + ticker);
      panel.querySelectorAll('[data-tab-btn]').forEach(b => b.classList.toggle('active', b === btn));
      panel.querySelectorAll('[data-tab-panel]').forEach(p => {
        p.hidden = p.getAttribute('data-tab-panel') !== key;
      });
    });
  });

  /* ---- "지난 리포트" calendar popover ---- */
  const HISTORY = {{ history_json | safe }};
  const CURRENT_DATE = "{{ date }}";
  const calBtn = document.getElementById('calBtn');
  const calPopover = document.getElementById('calPopover');
  calBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    calPopover.classList.toggle('open');
  });
  document.addEventListener('click', (e) => {
    if (!calPopover.contains(e.target) && e.target !== calBtn && !calBtn.contains(e.target)) {
      calPopover.classList.remove('open');
    }
  });

  (function initCalendar() {
    const dateMap = new Map(HISTORY.map(h => [h.label, h.url]));
    const [cy, cm] = CURRENT_DATE.split('-').map(Number);
    let viewYear = cy, viewMonth = cm - 1;
    const grid = document.getElementById('calGrid');
    const label = document.getElementById('calMonthLabel');
    const DOW = ['일', '월', '화', '수', '목', '금', '토'];

    function render() {
      label.textContent = viewYear + '년 ' + (viewMonth + 1) + '월';
      grid.innerHTML = '';
      DOW.forEach(d => {
        const el = document.createElement('div');
        el.className = 'cal-dow';
        el.textContent = d;
        grid.appendChild(el);
      });
      const firstDay = new Date(viewYear, viewMonth, 1).getDay();
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
      for (let i = 0; i < firstDay; i++) grid.appendChild(document.createElement('div'));
      for (let d = 1; d <= daysInMonth; d++) {
        const mm = String(viewMonth + 1).padStart(2, '0');
        const dd = String(d).padStart(2, '0');
        const key = viewYear + '-' + mm + '-' + dd;
        const hasReport = dateMap.has(key);
        const cell = document.createElement(hasReport ? 'a' : 'div');
        cell.textContent = String(d);
        cell.className = 'cal-day' + (hasReport ? ' has-report' : '') + (key === CURRENT_DATE ? ' current' : '');
        if (hasReport) cell.href = dateMap.get(key);
        grid.appendChild(cell);
      }
    }
    document.getElementById('calPrev').addEventListener('click', () => {
      viewMonth--; if (viewMonth < 0) { viewMonth = 11; viewYear--; } render();
    });
    document.getElementById('calNext').addEventListener('click', () => {
      viewMonth++; if (viewMonth > 11) { viewMonth = 0; viewYear++; } render();
    });
    render();
  })();

  /* ---- Rotating news headlines (pool of up to 5, 2 slots visible) ---- */
  const NEWS_POOL = {{ news_pool_json | safe }};
  const LINK_ICON = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>';
  let hlIndex = 0;
  function renderHeadlineRow(el, item) {
    if (!item) { el.innerHTML = ''; return; }
    el.style.opacity = '0';
    setTimeout(() => {
      el.innerHTML = '<span class="headline-tag">' + item.tag + '</span>' +
        '<span>' + item.text + '</span>' +
        '<a class="src-link" href="' + item.url + '" target="_blank" rel="noopener">' + LINK_ICON + '</a>';
      el.style.opacity = '1';
    }, 180);
  }
  function tickHeadlines() {
    if (!NEWS_POOL.length) return;
    const row0 = document.getElementById('hlRow0');
    const row1 = document.getElementById('hlRow1');
    row0.style.transition = 'opacity 0.18s ease';
    row1.style.transition = 'opacity 0.18s ease';
    renderHeadlineRow(row0, NEWS_POOL[hlIndex % NEWS_POOL.length]);
    renderHeadlineRow(row1, NEWS_POOL.length > 1 ? NEWS_POOL[(hlIndex + 1) % NEWS_POOL.length] : null);
    hlIndex = (hlIndex + 2) % NEWS_POOL.length;
  }
  tickHeadlines();
  if (NEWS_POOL.length > 2) setInterval(tickHeadlines, 9000);
</script>
</body>
</html>
